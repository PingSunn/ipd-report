    "db:deploy": "prisma migrate deploy",
    "db:seed:mock": "bun scripts/seed-mock-census.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "line:worker": "bun scripts/line-worker.ts",
    "line:webhook-proxy": "bun scripts/line-webhook-proxy.ts"
  },
  "dependencies": {
    "@daypicker/buddhist": "^10.0.2",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "7",
    "radix-ui": "^1.8.1",
    "react": "^19.0.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
