{
  "name": "ipd-report",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "prisma generate && next build",
    "clean": "rm -rf .next",
    "lint": "tsc --noEmit",
    "db:up": "docker compose up -d db",
