# Local PostgreSQL from compose.yaml.
DATABASE_URL="postgresql://ipd_report:ipd_report_local@127.0.0.1:45432/ipd_report?schema=public"
# Prisma migrations use a direct connection. Keep it equal to DATABASE_URL locally.
DIRECT_URL="postgresql://ipd_report:ipd_report_local@127.0.0.1:45432/ipd_report?schema=public"

# Better Auth / Google OAuth. Use the same Google OAuth client for local and deployed app URLs.
BETTER_AUTH_URL="http://localhost:40273"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:40273,https://ipd.pingsunn.com"
NEXT_PUBLIC_APP_URL="http://localhost:40273"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_BOOTSTRAP_EMAIL=""
# LINE webhook secret is mounted into the web process. The access token is
# mounted into the worker only.
# Set this on the web process; keep LINE_CHANNEL_ACCESS_TOKEN on the worker only.
LINE_CHANNEL_ACCESS_TOKEN_CONFIGURED="false"
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
